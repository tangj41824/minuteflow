# Required only for a live Agent run. Never commit the real key.
OPENAI_API_KEY=

# Efficient default for short extraction and verification tasks.
MINUTEFLOW_MODEL=gpt-5.6-luna
MINUTEFLOW_REASONING_EFFORT=low

# Traces can contain meeting content, so export is opt-in.
MINUTEFLOW_ENABLE_TRACING=false

# Reject unexpectedly large inputs before any model request.
MINUTEFLOW_MAX_INPUT_CHARS=100000

# --- OpenAI-compatible endpoint (e.g. DeepSeek) ---
# Leave MINUTEFLOW_BASE_URL empty to use the OpenAI default endpoint. To use
# DeepSeek instead, set all three:
#   MINUTEFLOW_BASE_URL=https://api.deepseek.com
#   MINUTEFLOW_MODEL=deepseek-v4-pro
#   DEEPSEEK_API_KEY=sk-...
MINUTEFLOW_BASE_URL=
DEEPSEEK_API_KEY=
# MINUTEFLOW_API_KEY=  # alternative provider key; takes precedence over DEEPSEEK_API_KEY

# Local web UI history location (default ~/.minuteflow/history).
# MINUTEFLOW_HISTORY_DIR=~/.minuteflow/history
